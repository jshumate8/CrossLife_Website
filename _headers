/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  
  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://identity.netlify.com https://donorbox.org https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src https://donorbox.org https://www.google.com; connect-src 'self' https://identity.netlify.com https://*.netlify.app https://donorbox.org; frame-ancestors 'none';

# Protected pages - add authentication requirement
/studies.html
  Cache-Control: no-store, no-cache, must-revalidate
/teachings.html
  Cache-Control: no-store, no-cache, must-revalidate
/resources.html
  Cache-Control: no-store, no-cache, must-revalidate
